{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-qemu-dbg",
      "type": "shell",
      "command": "make dbg_run",
      "isBackground": true,
      "problemMatcher": {
        "owner": "qemu",
        "pattern": {
          "regexp": "^(.*)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^(.*)$",
          "endsPattern": "^(.*QEMU.*|.*qemu-system.*)$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
